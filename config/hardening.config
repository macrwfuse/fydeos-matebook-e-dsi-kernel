# Applied last; wins over both the openFyde 6.6 config and the chromeos-6.12 fragments.
#
# Release string must be byte-identical to the stock FydeOS v23 kernel, otherwise
# modules land in a different /lib/modules directory and the i915.ko artifact is
# useless. VERSION=6 PATCHLEVEL=12 SUBLEVEL=54 + this suffix, with
# setlocalversion returning nothing (tarball build, no .git), gives
# "6.12.54-01180-gb4e10020ba49-dirty" -- what FydeOS v23 reports.
#
# The suffix is NOT set here: scripts/setlocalversion reads CONFIG_LOCALVERSION from
# include/config/auto.conf without unquoting it (confdata.c skips escaping for
# S_DEF_AUTO), so a quoted value leaks its quotes into UTS_RELEASE. build-kernel.sh
# writes a `localversion-fyde` file in the source tree instead.
# CONFIG_LOCALVERSION is not set
# CONFIG_LOCALVERSION_AUTO is not set

# i915 as a module so the patched driver can also be shipped standalone.
CONFIG_DRM_I915=m
CONFIG_DRM_I915_FORCE_PROBE="*"

# Plain, unsigned, unversioned modules -- same as stock.
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_MODVERSIONS is not set

# Bootable directly as /efi/syslinux/vmlinuz.A.
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# No debug info: keeps a 6.12 defconfig-ish build inside a GitHub runner's disk
# quota. It does not affect module compatibility or runtime behaviour.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set

# The patches add a couple of call sites; a stray warning must not kill a 40
# minute build.
# CONFIG_WERROR is not set
