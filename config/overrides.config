# Applied on top of config/fydeos-official-iris.config (a byte-identical copy of
# the stock FydeOS v23 kernel's /proc/config.gz).  Only build-output settings
# live here; anything that changes the module ABI would defeat the point of
# starting from the stock config.
#
# The release string is NOT set here.  build-kernel.sh writes a
# `localversion-fyde` file into the source tree instead: scripts/setlocalversion
# reads CONFIG_LOCALVERSION out of include/config/auto.conf as a raw string, so
# a quoted value leaks its quotes into UTS_RELEASE.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# No debug info.  The stock config has DEBUG_INFO=y + DWARF5, which turns a
# ~2000-file build into a ~20 GB one and does not fit on a GitHub runner.
# Debug info has no effect on vermagic or on any struct layout.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set

# keep /proc/config.gz available without `modprobe configs` (stock has
# IKCONFIG=m); costs ~50 kB in the image.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# The ported ChromiumOS subsystems (alt-syscall, esdfs, ashmem, uid_sys_stats)
# are 5.4-era code.  They compile on 6.12, but not warning-free under every
# clang/gcc revision.  A stray warning must not kill a 60 minute build.
# CONFIG_WERROR is not set

# Stock values, restated so a future edit of the base config cannot silently
# change them: modules must stay plain, unsigned and unversioned, and i915 must
# stay a module so it can also be shipped standalone.
# MODULE_DECOMPRESS only exists when MODULE_COMPRESS is on; restate both so the
# stock ".ko" layout is preserved whatever the base says.
# CONFIG_MODULE_SIG is not set
# CONFIG_MODVERSIONS is not set
# CONFIG_MODULE_COMPRESS is not set
# CONFIG_MODULE_DECOMPRESS is not set
CONFIG_DRM_I915=m
