--- a/kernel/bpf/token.c
+++ b/kernel/bpf/token.c
@@ -18,8 +18,15 @@
 {
 	struct user_namespace *userns;
 
-	/* BPF token allows ns_capable() level of capabilities */
-	userns = token ? token->userns : &init_user_ns;
+	/*
+	 * BPF token allows ns_capable() level of capabilities. Without a token,
+	 * Chromium OS checks them in the caller's own user namespace, so the
+	 * root of the Android container's user namespace qualifies; upstream
+	 * checks against init_user_ns instead, which makes every bpf() call from
